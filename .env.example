# Copy to .env for local development, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Resend API key (https://resend.com/api-keys). Without it, quote requests are logged to the console instead of emailed.
RESEND_API_KEY=

# Where quote requests are delivered.
NOTIFICATION_EMAIL=

# Sender shown on lead emails. onboarding@resend.dev only delivers to your own Resend account email;
# verify your domain in Resend to send from e.g. "Glossiva Lighting <quotes@yourdomain.ca>".
RESEND_FROM=Glossiva Lighting <onboarding@resend.dev>
