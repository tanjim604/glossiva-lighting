---
// Shown after a no-JavaScript form submission (the normal flow shows the thank-you in place).
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { withBase } from '../utils/url';
---

<Base title={`Thank you | ${site.name}`} noindex>
  <main class="grid min-h-dvh place-items-center bg-slate-50 px-4 py-16">
    <div class="w-full max-w-lg rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-xl sm:p-10">
      <a href={withBase()} class="inline-flex" aria-label="Glossiva, back to the site"><Logo eager /></a>
      <span class="mx-auto mt-8 grid size-16 place-items-center rounded-full bg-brand-700 text-white shadow-lg">
        <Icon name="check" class="size-8" strokeWidth={2.6} />
      </span>
      <h1 class="mt-6 text-3xl font-extrabold tracking-tight text-slate-900">Thank you!</h1>
      <p class="mt-3 text-base leading-relaxed font-medium text-slate-600">
        Your quote request is on its way. We’ll be in touch {site.responseTime} with your free quote.
      </p>
      <a href={withBase()} class="btn btn-outline mt-8">
        <Icon name="chevronLeft" class="size-4" strokeWidth={2.4} /> Back to the site
      </a>
    </div>
  </main>
</Base>
