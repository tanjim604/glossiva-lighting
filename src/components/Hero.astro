---
import { Picture } from 'astro:assets';
import heroBg from '../assets/photos/hero-blur.jpg';
import { site } from '../data/site';
import Icon from './Icon.astro';
---

<section id="top" class="hero relative isolate overflow-hidden bg-slate-900 text-white">
  {/* Pre-blurred at build time (src/assets/photos/hero-blur.jpg): no CSS filter cost, and a tiny file. */}
  <Picture
    src={heroBg}
    alt=""
    widths={[640, 960, 1280, 1600]}
    sizes="100vw"
    formats={['avif', 'webp']}
    loading="eager"
    fetchpriority="high"
    class="hero-bg"
  />
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-slate-950/55 via-slate-950/40 to-slate-950/75" aria-hidden="true"></div>
  <div class="absolute inset-0 -z-10 hidden bg-gradient-to-r from-slate-950/70 via-slate-950/30 to-transparent lg:block" aria-hidden="true"></div>

  <div class="container-x py-14 sm:py-20 lg:py-28">
    <div class="hero-grid">
      <div class="hero-intro">
        <p class="hero-in inline-flex items-center gap-2 rounded-full border border-white/25 bg-white/10 px-3.5 py-1.5 text-[0.6875rem] font-extrabold tracking-[0.14em] text-amber-200 uppercase backdrop-blur-sm" style="--d:0ms">
          <Icon name="pin" class="size-3.5" strokeWidth={2.4} />
          {site.city}, {site.region}
        </p>
        <h1 class="hero-in mt-5 text-[2.5rem] leading-[1.03] font-extrabold tracking-tight sm:text-5xl lg:text-6xl" style="--d:80ms">
          Kamloops, <span class="text-amber-300">Let Us Light Up Your Christmas.</span>
        </h1>
        <p class="hero-in mt-4 text-lg font-medium text-slate-200" style="--d:160ms">
          Installed and taken down for you.
        </p>
      </div>

      <aside class="hero-card hero-in" style="--d:220ms" aria-label="Pricing">
        <div class="price-card">
          <p class="text-[0.6875rem] font-extrabold tracking-[0.14em] text-amber-200 uppercase">Roofline lighting</p>
          <p class="mt-1 flex items-baseline gap-2 leading-none font-extrabold">
            <span class="text-[4.5rem] tracking-tighter text-white sm:text-[5rem]">{site.price.amount}</span>
            <span class="text-xl font-bold text-slate-200">/ bulb / ft</span>
          </p>
          <a href="#quote" class="btn btn-primary mt-5 w-full" data-hero-cta>
            Get my free quote <Icon name="arrowRight" class="size-4" strokeWidth={2.4} />
          </a>
        </div>
      </aside>

      <div class="hero-actions hero-in" style="--d:300ms">
        <div class="flex flex-wrap items-center gap-3">
          <a href="#packages" class="btn btn-ghost">View packages</a>
          <span class="inline-flex items-center gap-2 rounded-xl border border-white/20 bg-white/10 px-4 py-3 text-sm font-bold backdrop-blur-sm">
            <Icon name="shield" class="size-5 text-amber-300" strokeWidth={2} />
            {site.insurance.amount} insured
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero :global(picture) {
    position: absolute;
    inset: 0;
    z-index: -20;
  }
  .hero :global(.hero-bg) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 60%;
    animation: settle 2.4s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  /* Phones: text → $7 card → secondary actions. Desktop: text and actions left, $7 card right. */
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'intro' 'card' 'actions';
    gap: 1.75rem;
  }
  .hero-intro { grid-area: intro; }
  .hero-card { grid-area: card; }
  .hero-actions { grid-area: actions; }

  .price-card {
    max-width: 24rem;
    border-radius: 1rem;
    border: 2px solid rgb(251 191 36 / 0.85);
    background: rgb(15 23 42 / 0.45);
    padding: 1.25rem 1.25rem 1.375rem;
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    box-shadow: 0 20px 45px -20px rgb(0 0 0 / 0.6);
  }

  .hero :global(.btn-ghost) {
    background: rgb(255 255 255 / 0.1);
    color: #fff;
    border: 1px solid rgb(255 255 255 / 0.3);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
  }

  @media (width >= 64rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      grid-template-areas:
        'intro card'
        'actions card';
      grid-template-rows: auto 1fr;
      column-gap: 4rem;
      row-gap: 2rem;
      align-items: start;
    }
    .hero-card { align-self: center; justify-self: end; width: 100%; max-width: 24rem; }
  }
</style>
