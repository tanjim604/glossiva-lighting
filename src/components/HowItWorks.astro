---
import Icon, { type IconName } from './Icon.astro';

const steps: { icon: IconName; title: string; text: string }[] = [
  { icon: 'form', title: 'Request a quote', text: 'Tell us about your home in under a minute. Free, with no obligation.' },
  { icon: 'design', title: 'We design', text: 'We plan your lights around your roofline, entrance, trees and bushes.' },
  { icon: 'home', title: 'We install', text: 'Our insured crew handles every ladder and has your home glowing for December.' },
  { icon: 'calendar', title: 'We take it down', text: 'In January we remove everything. Nothing to untangle, nothing to store.' },
];
---

<section id="how-it-works" class="border-b border-slate-200 bg-slate-50 py-20 lg:py-24">
  <div class="container-x">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end" data-stagger="90">
      <div class="lg:col-span-7">
        <p class="eyebrow" data-reveal>How it works</p>
        <h2 class="section-title mt-3" data-reveal>From quote to glow in four steps</h2>
      </div>
      <p class="section-lead lg:col-span-5" data-reveal>
        A done-for-you service from the first measurement to the January takedown. You just enjoy the lights.
      </p>
    </div>

    <ol class="mt-12 grid gap-5 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4" data-stagger="110">
      {
        steps.map((step, i) => (
          <li class="card-lift relative flex flex-col rounded-xl border border-slate-200 bg-white p-6 shadow-sm" data-reveal>
            <div class="flex items-start justify-between">
              <span class="text-5xl leading-none font-extrabold tracking-tight text-brand-700">0{i + 1}</span>
              <span class="grid size-12 place-items-center rounded-lg bg-brand-50 text-brand-700 ring-1 ring-brand-100">
                <Icon name={step.icon} class="size-6" strokeWidth={2} />
              </span>
            </div>
            <h3 class="mt-6 text-sm font-extrabold tracking-[0.14em] text-slate-900 uppercase">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed font-medium text-slate-600">{step.text}</p>
          </li>
        ))
      }
    </ol>

    <div class="mt-12 flex flex-col items-start gap-4 rounded-xl border border-brand-100 bg-brand-50 p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8" data-reveal>
      <div>
        <p class="text-lg font-extrabold text-slate-900">Ready to get started?</p>
        <p class="mt-1 text-sm font-medium text-slate-600">Roofline lighting at $7/bulb/ft. Your quote is free.</p>
      </div>
      <a href="#quote" class="btn btn-primary w-full sm:w-auto">
        Get my free quote <Icon name="arrowRight" class="size-4" strokeWidth={2.4} />
      </a>
    </div>
  </div>
</section>
