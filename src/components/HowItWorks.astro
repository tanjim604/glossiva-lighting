---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import design from '../assets/photos/step-design.jpg';
import install from '../assets/photos/step-install.jpg';
import quote from '../assets/photos/step-quote.jpg';
import takedown from '../assets/photos/step-takedown.jpg';

// Public-domain (CC0) stand-in photos; replace with Glossiva's own (or AI-generated) images later.
const steps: { image: ImageMetadata; alt: string; title: string; text: string }[] = [
  { image: quote, alt: 'Person holding a phone at a laptop', title: 'Request a quote', text: 'Takes under a minute.' },
  { image: design, alt: 'Planning desk with a set square and laptop', title: 'We design', text: 'Planned around your home.' },
  { image: install, alt: 'Worker on the edge of a house roof', title: 'We install', text: 'Our insured crew does it all.' },
  { image: takedown, alt: 'Person holding a string of lights at dusk', title: 'We take it down', text: 'In January. Nothing to store.' },
];
---

<section id="how-it-works" class="border-b border-slate-200 bg-slate-50 py-16 lg:py-20">
  <div class="container-x">
    <div class="mx-auto max-w-3xl text-center" data-stagger="90">
      <p class="eyebrow" data-reveal>How it works</p>
      <h2 class="section-title mt-3" data-reveal>Four simple steps</h2>
    </div>

    <ol class="mt-10 grid grid-cols-2 gap-3 sm:gap-5 lg:mt-12 lg:grid-cols-4" data-stagger="110">
      {
        steps.map((step, i) => (
          <li class="card-lift overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm" data-reveal>
            <div class="step-media">
              <Picture
                src={step.image}
                alt={step.alt}
                widths={[400, 600, 800]}
                sizes="(min-width: 1024px) 22vw, 46vw"
                formats={['avif', 'webp']}
                loading="lazy"
                decoding="async"
              />
              <span class="step-num">0{i + 1}</span>
            </div>
            <div class="p-3.5 sm:p-5">
              <h3 class="text-base font-extrabold text-slate-900 sm:text-lg">{step.title}</h3>
              <p class="mt-1 text-sm font-medium text-slate-600">{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .step-media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-slate-200);
  }
  .step-media :global(picture) { display: block; height: 100%; }
  .step-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @media (hover: hover) {
    li:hover .step-media :global(img) { transform: scale(1.05); }
  }
  .step-num {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.5rem;
    background: var(--color-brand-700);
    color: #fff;
    font-size: 0.9375rem;
    font-weight: 800;
    box-shadow: 0 8px 20px -8px rgb(0 0 0 / 0.5);
  }
</style>
