---
import { nav, site, telHref } from '../data/site';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
---

<div class="bg-brand-700 text-xs text-white">
  <div class="container-x flex items-center justify-between gap-3 py-2">
    <span class="inline-flex items-center gap-1.5 font-bold">
      <Icon name="tag" class="size-3.5 text-amber-300" strokeWidth={2.4} />
      Roofline lighting {site.price.compact}
    </span>
    <div class="flex items-center gap-4 font-semibold">
      <span class="inline-flex items-center gap-1.5">
        <Icon name="shield" class="size-4 text-amber-300" strokeWidth={2} />
        {site.insurance.amount} insured
      </span>
      <span class="hidden items-center gap-1.5 sm:inline-flex">
        <Icon name="pin" class="size-4 text-amber-300" strokeWidth={2} />
        {site.city}, {site.region}
      </span>
      {
        site.phone && (
          <a href={telHref(site.phone)} class="hidden items-center gap-1.5 underline-offset-2 hover:underline md:inline-flex">
            <Icon name="phone" class="size-4" strokeWidth={2} />
            {site.phone}
          </a>
        )
      }
    </div>
  </div>
</div>

<header class="site-header sticky top-0 z-50 border-b border-slate-200 bg-white/95 backdrop-blur-md" data-header>
  <div class="container-x flex h-16 items-center justify-between gap-3 lg:h-20">
    <a href="#top" class="shrink-0" aria-label="Glossiva Holiday Lighting & Decor, back to top">
      <Logo eager />
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-8 text-sm font-semibold text-slate-700">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="transition-colors hover:text-brand-700">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href="#quote" class="btn btn-primary btn-sm">
        <span class="sm:hidden">Get quote</span>
        <span class="hidden sm:inline">Get a free quote</span>
        <Icon name="arrowRight" class="hidden size-4 sm:block" strokeWidth={2.4} />
      </a>
      <button
        type="button"
        class="grid size-11 place-items-center rounded-lg text-slate-700 transition-colors hover:bg-slate-100 lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <Icon name="menu" class="size-6" strokeWidth={2} />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="border-t border-slate-200 bg-white lg:hidden" hidden data-mobile-menu>
    <nav aria-label="Mobile" class="container-x py-3">
      <ul class="grid gap-1 text-base font-semibold text-slate-800">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="block rounded-lg px-3 py-3 transition-colors hover:bg-slate-50 hover:text-brand-700" data-menu-link>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a href="#quote" class="btn btn-primary mt-3 mb-2 w-full" data-menu-link>
        Get my free quote <Icon name="arrowRight" class="size-4" strokeWidth={2.4} />
      </a>
    </nav>
  </div>
</header>

<style>
  /* A soft shadow appears once the page is scrolled (toggled in chrome.ts). */
  .site-header {
    transition: box-shadow 0.3s;
  }
  .site-header:global(.is-scrolled) {
    box-shadow: 0 8px 24px -16px rgb(15 23 42 / 0.35);
  }
</style>
