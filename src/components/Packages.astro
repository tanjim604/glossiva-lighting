---
import { packages, packagesFootnote } from '../data/packages';
import PackageCard from './PackageCard.astro';
---

<section id="packages" class="border-b border-slate-200 bg-white py-16 lg:py-20">
  <div class="container-x">
    <div class="mx-auto max-w-3xl text-center" data-stagger="90">
      <p class="eyebrow" data-reveal>Packages</p>
      <h2 class="section-title mt-3" data-reveal>Christmas light packages</h2>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:mt-12 lg:grid-cols-4" data-stagger="110">
      {packages.map((pkg) => <PackageCard pkg={pkg} />)}
    </div>

    <p class="mt-8 text-center text-xs font-medium text-slate-500" data-reveal>{packagesFootnote}</p>
  </div>
</section>
