---
/**
 * The Glossiva logo. Source art: src/assets/brand/logo.png (the owner's file).
 * - `horizontal`: the mark beside the wordmark, cropped from the original, for the header.
 * - `stacked`: the full original logo, for the footer and thank-you page.
 * Astro serves resized WebP versions, so the large source PNGs never reach visitors.
 */
import { Image } from 'astro:assets';
import full from '../assets/brand/logo-full.png';
import mark from '../assets/brand/logo-mark.png';
import wordmark from '../assets/brand/logo-wordmark.png';

interface Props {
  variant?: 'horizontal' | 'stacked';
  /** Load immediately (header) instead of lazily. */
  eager?: boolean;
  class?: string;
}
const { variant = 'horizontal', eager = false, class: className = '' } = Astro.props;
const loading = eager ? 'eager' : 'lazy';
const alt = 'Glossiva Holiday Lighting & Decor';
---

{
  variant === 'horizontal' ? (
    <span class:list={['logo-h', className]}>
      <Image src={mark} alt="" widths={[64, 96, 128, 176]} sizes="(min-width: 1024px) 60px, 52px" quality={72} loading={loading} class="logo-mark" />
      <Image
        src={wordmark}
        alt={alt}
        widths={[140, 240, 360, 520]}
        sizes="(min-width: 1024px) 175px, 135px"
        quality={72}
        loading={loading}
        class="logo-word"
      />
    </span>
  ) : (
    <Image
      src={full}
      alt={alt}
      widths={[200, 360, 540]}
      sizes="176px"
      quality={75}
      loading={loading}
      class:list={['logo-stacked', className]}
    />
  )
}

<style>
  .logo-h {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }
  .logo-h :global(img) {
    display: block;
    width: auto;
  }
  /* Scales with the viewport so it fits beside the quote button and menu icon on 360px phones. */
  .logo-h :global(.logo-mark) {
    height: clamp(2rem, 9.4vw, 2.75rem);
  }
  .logo-h :global(.logo-word) {
    height: clamp(1.125rem, 5.4vw, 1.625rem);
  }
  @media (width >= 64rem) {
    .logo-h { gap: 0.5rem; }
    .logo-h :global(.logo-mark) { height: 3rem; }
    .logo-h :global(.logo-word) { height: 1.75rem; }
  }
  :global(.logo-stacked) {
    display: block;
    width: 11rem;
    height: auto;
  }
</style>
