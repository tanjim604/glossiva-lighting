---
import { site } from '../data/site';
import Icon, { type IconName } from './Icon.astro';

// Only facts the owner has confirmed. Add reviews or install counts here once they're real.
const stats = [
  { value: site.price.amount, label: 'Per bulb / ft' },
  { value: site.insurance.amount, label: 'Insurance coverage' },
  { value: '4', label: 'Packages to choose from' },
  { value: 'Free', label: 'No-obligation quotes' },
];
const reasons: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'shield',
    title: 'Fully insured',
    text: `We carry ${site.insurance.amount} in insurance coverage, so you have peace of mind while our crew works on your home.`,
  },
  {
    icon: 'checkCircle',
    title: 'Nothing to buy or store',
    text: 'You rent the lights for the season. We take everything back in January, so there’s nothing to untangle or store.',
  },
  {
    icon: 'calendar',
    title: 'Done for you',
    text: 'Design, installation and January takedown are all handled by our team. You just enjoy the glow.',
  },
];
---

<section id="why" class="border-b border-slate-200 bg-slate-50 py-20 lg:py-24">
  <div class="container-x">
    <div class="mx-auto max-w-3xl text-center" data-stagger="90">
      <p class="eyebrow" data-reveal>Why Glossiva</p>
      <h2 class="section-title mt-3" data-reveal>Simple pricing. Fully insured. Done for you.</h2>
    </div>

    <dl class="mt-12 grid grid-cols-2 overflow-hidden rounded-xl border border-slate-200 bg-white lg:grid-cols-4" data-reveal>
      {
        stats.map((s, i) => (
          <div
            class:list={[
              'flex flex-col gap-1 p-6 text-center',
              i % 2 === 1 && 'border-l border-slate-200',
              i >= 2 && 'border-t border-slate-200 lg:border-t-0',
              i === 2 && 'lg:border-l',
            ]}
          >
            <dt class="text-xs font-bold tracking-wider text-slate-500 uppercase">{s.label}</dt>
            <dd class="order-first text-4xl font-extrabold tracking-tight text-brand-700 sm:text-5xl">{s.value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-8 grid gap-5 md:grid-cols-3" data-stagger="110">
      {
        reasons.map((r) => (
          <div class="card-lift rounded-xl border border-slate-200 bg-white p-7 shadow-sm" data-reveal>
            <span class="grid size-11 place-items-center rounded-lg bg-brand-50 text-brand-700 ring-1 ring-brand-100">
              <Icon name={r.icon} class="size-5.5" strokeWidth={2} />
            </span>
            <h3 class="mt-5 text-lg font-extrabold text-slate-900">{r.title}</h3>
            <p class="mt-2 text-sm leading-relaxed font-medium text-slate-600">{r.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
