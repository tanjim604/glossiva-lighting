---
import { faqs } from '../data/faq';
import { site, telHref } from '../data/site';
import Icon from './Icon.astro';
---

<section id="faq" class="bg-slate-50 py-16 lg:py-20">
  <div class="container-x">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4" data-stagger="90">
        <p class="eyebrow" data-reveal>FAQ</p>
        <h2 class="section-title mt-3" data-reveal>Questions, answered</h2>
        <div class="mt-6 flex flex-wrap gap-3" data-reveal>
          <a href="#quote" class="btn btn-primary">Get my free quote</a>
          {
            site.phone && (
              <a href={telHref(site.phone)} class="btn btn-outline">
                <Icon name="phone" class="size-4" /> {site.phone}
              </a>
            )
          }
        </div>
      </div>

      <div class="grid gap-3 lg:col-span-8" data-stagger="60">
        {
          faqs.map((item) => (
            <details class="faq-item" data-accordion data-reveal>
              <summary class="faq-q">
                <span>{item.q}</span>
                <span class="faq-icon" aria-hidden="true">
                  <Icon name="plus" class="size-4" strokeWidth={2.4} />
                </span>
              </summary>
              <div class="overflow-hidden" data-accordion-content>
                <p class="px-5 pb-5 text-[0.9375rem] leading-relaxed font-medium text-slate-600 sm:px-6">{item.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .faq-item {
    border-radius: 0.75rem;
    border: 1px solid var(--color-slate-200);
    background: #fff;
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .faq-item[open] {
    border-color: var(--color-brand-200);
    box-shadow: 0 12px 30px -20px rgb(15 23 42 / 0.3);
  }
  .faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.75rem;
    padding: 1rem 1.25rem;
    cursor: pointer;
    list-style: none;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--color-slate-900);
  }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border-radius: 0.5rem;
    background: var(--color-slate-100);
    color: var(--color-slate-700);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.3s, color 0.3s;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    background: var(--color-brand-700);
    color: #fff;
  }
  @media (hover: hover) {
    .faq-item:not([open]):hover { border-color: var(--color-slate-300); }
  }
  @media (width >= 40rem) {
    .faq-q { padding: 1.125rem 1.5rem; font-size: 1.0625rem; }
  }
</style>
