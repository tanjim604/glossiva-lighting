---
import { site } from '../data/site';
import Icon from './Icon.astro';

// Bulbs hanging from an eave, for the "how $7/bulb/ft works" diagram.
const bulbColors = ['#e0485f', '#f4b63f', '#2f9e62'];
const diagramBulbs = Array.from({ length: 8 }, (_, i) => ({ x: 28 + i * 49, c: bulbColors[i % 3], i }));
---

<section id="pricing" class="sheet bg-cream pt-14 pb-24 lg:pt-20 lg:pb-32" data-pause-offscreen>
  <div class="container-x">
    <div class="grid gap-4 lg:grid-cols-[1.55fr_1fr] lg:gap-6" data-stagger="140">
      <article class="price-card card card-hover" data-reveal>
        <div class="price-copy">
          <p class="eyebrow"><span class="eyebrow-dot"></span>Simple, upfront pricing</p>
          <p class="price-figure">
            <span class="price-amount font-display gold-numerals">{site.price.amount}</span>
            <span class="price-unit">{site.price.unit}</span>
          </p>
          <p class="price-text">
            One clear rate for roofline lighting, measured along your roofline. Your free quote shows your exact
            footage and total, so there are no surprises.
          </p>
        </div>

        <figure class="price-diagram" aria-label="Diagram: one bulb per foot of roofline, $7 each">
          <div class="diagram-art">
          {/* Glows twinkle on their own overlay <svg>s so the animation stays GPU-composited. */}
          {
            [0, 1].map((g) => (
              <svg viewBox="0 0 400 150" class={`glow-layer glow-${g}`} aria-hidden="true">
                {diagramBulbs
                  .filter((b) => b.i % 2 === g)
                  .map((b) => (
                    <circle cx={b.x} cy="84" r="22" fill={`url(#hl-glow-${b.i % 3})`} />
                  ))}
              </svg>
            ))
          }
          <svg viewBox="0 0 400 150" role="img" aria-hidden="true">
            <defs>
              {
                bulbColors.map((c, i) => (
                  <radialGradient id={`hl-glow-${i}`}>
                    <stop offset="0" stop-color={c} stop-opacity="0.55" />
                    <stop offset="1" stop-color={c} stop-opacity="0" />
                  </radialGradient>
                ))
              }
            </defs>
            <!-- roof + eave -->
            <path d="M0 54 L400 54 L400 30 Q200 4 0 30 Z" fill="#f1e5d1" />
            <path d="M0 54 H400" stroke="#1f4a36" stroke-width="3.5" stroke-linecap="round" />
            <!-- 1 ft dimension between two bulbs -->
            <g class="dim" stroke="#845a12" stroke-width="2" fill="none" stroke-linecap="round">
              <path d={`M${diagramBulbs[3].x} 22 V12 H${diagramBulbs[4].x} V22`} />
            </g>
            <text x={(diagramBulbs[3].x + diagramBulbs[4].x) / 2} y="8" text-anchor="middle" class="dim-label">1 ft</text>
            {
              diagramBulbs.map((b) => (
                <g class="d-bulb">
                  <rect x={b.x - 4} y="54" width="8" height="8" rx="2" fill="#173828" />
                  <path
                    d={`M${b.x} 61c7 0 9.5 8 6.4 15.2-1.6 3.6-3.9 6.8-6.4 9.8-2.5-3-4.8-6.2-6.4-9.8C${b.x - 9.5} 69 ${b.x - 7} 61 ${b.x} 61Z`}
                    fill={b.c}
                  />
                  <ellipse cx={b.x - 2.4} cy="68" rx="1.6" ry="3" fill="#fff" opacity="0.7" />
                </g>
              ))
            }
            <!-- price callout under the highlighted bulb -->
            <g transform={`translate(${diagramBulbs[4].x} 118)`}>
              <rect x="-26" y="-13" width="52" height="26" rx="13" fill="#1f4a36" />
              <text y="5" text-anchor="middle" class="callout">$7</text>
            </g>
          </svg>
          </div>
          <figcaption class="diagram-caption">One bulb per foot of roofline · $7 each</figcaption>
        </figure>
      </article>

      <article class="ins-card card card-hover" data-reveal>
        <span class="ins-card-icon"><Icon name="shield" class="size-8" strokeWidth={1.9} /></span>
        <p class="ins-card-amount font-display">{site.insurance.amount}</p>
        <p class="ins-card-label">{site.insurance.label}</p>
        <p class="ins-card-text">
          Our crew handles the ladders and rooftops, and your home is covered by $3M in insurance while we work.
        </p>
      </article>
    </div>
  </div>
</section>

<style>
  .price-card {
    position: relative;
    overflow: hidden;
    display: grid;
    gap: 1.5rem;
    padding: 1.75rem 1.25rem 1.5rem;
    border-radius: 2rem;
    background:
      radial-gradient(120% 90% at 0% 0%, rgb(255 217 138 / 0.35), transparent 55%),
      #fff;
  }
  .price-figure {
    margin-top: 1rem;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    column-gap: 0.75rem;
  }
  .price-amount {
    font-size: clamp(5.5rem, 4rem + 7vw, 8.5rem);
    line-height: 0.85;
    font-weight: 750;
    letter-spacing: -0.05em;
    filter: drop-shadow(0 10px 24px rgb(212 160 63 / 0.35));
  }
  .price-unit {
    font-size: clamp(1.375rem, 1.1rem + 1vw, 1.875rem);
    font-weight: 700;
    color: var(--color-pine);
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100;
  }
  .price-text {
    margin-top: 1rem;
    max-width: 30rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-muted);
  }
  .price-diagram {
    border-radius: 1.5rem;
    background: var(--color-snow);
    border: 1px solid var(--color-line);
    padding: 1rem 0.75rem 0.875rem;
  }
  .diagram-art {
    position: relative;
  }
  .diagram-art svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .diagram-art svg:not(.glow-layer) {
    position: relative;
  }
  .glow-layer {
    position: absolute;
    inset: 0;
  }
  .dim-label {
    font: 700 13px var(--font-jakarta);
    fill: #845a12;
  }
  .callout {
    font: 800 14px var(--font-jakarta);
    fill: #fff;
  }
  .diagram-caption {
    margin-top: 0.5rem;
    text-align: center;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-muted);
  }
  .glow-0 { animation: glow-pulse 3.2s ease-in-out infinite; }
  .glow-1 { animation: glow-pulse 3.2s ease-in-out -1.6s infinite; }
  @keyframes glow-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .ins-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 1.75rem 1.5rem;
    border-radius: 2rem;
    background:
      radial-gradient(110% 80% at 100% 0%, rgb(207 227 211 / 0.6), transparent 60%),
      #fff;
  }
  .ins-card-icon {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: 999px;
    color: #fff;
    background: linear-gradient(160deg, #2b6047, #1f4a36);
    box-shadow: 0 12px 28px -10px rgb(31 74 54 / 0.6), inset 0 1px 0 rgb(255 255 255 / 0.2);
  }
  .ins-card-amount {
    margin-top: 1.25rem;
    font-size: clamp(3.5rem, 2.8rem + 3vw, 5rem);
    line-height: 0.9;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--color-pine);
  }
  .ins-card-label {
    margin-top: 0.375rem;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-pine);
  }
  .ins-card-text {
    margin-top: 0.875rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  @media (width >= 48rem) {
    .price-card { grid-template-columns: 1fr 1fr; align-items: center; padding: 2.5rem; }
    .ins-card { padding: 2.5rem; }
  }
  @media (width >= 64rem) {
    .price-card { grid-template-columns: 1.05fr 1fr; padding: 3rem; }
    .ins-card { justify-content: center; padding: 3rem 2.5rem; }
  }
</style>
