---
/**
 * A draped string of C9-style bulbs. The wire is an SVG stretched to the container width
 * (fixed height), and bulbs are positioned along the same curve with % for x and px for y,
 * so they stay on the wire at every screen width.
 *
 * `autoplay` lights the string immediately (hero); otherwise main.ts lights it when it
 * scrolls into view.
 */
interface Props {
  swags?: number;
  bulbs?: number;
  height?: number;
  top?: number;
  sag?: number;
  delay?: number;
  step?: number;
  small?: boolean;
  autoplay?: boolean;
  class?: string;
}

const {
  swags = 3,
  bulbs = 24,
  height = 72,
  top = 8,
  sag = 34,
  delay = 600,
  step = 70,
  small = false,
  autoplay = false,
  class: className = '',
} = Astro.props;

const W = 1000;
const swagW = W / swags;
const perSwag = Math.max(1, Math.round(bulbs / swags));
const colors = ['var(--color-bulb-red)', 'var(--color-bulb-gold)', 'var(--color-bulb-green)'];
const rand = (n: number) => {
  const s = Math.sin(n * 12.9898) * 43758.5453;
  return s - Math.floor(s);
};

// Quadratic swag from (x0, top) to (x1, top) dipping `sag` px in the middle.
const yAt = (t: number) => top + 4 * sag * t * (1 - t);

const wire = Array.from({ length: swags }, (_, s) => {
  const x0 = s * swagW;
  const x1 = x0 + swagW;
  return `${s === 0 ? `M ${x0} ${top}` : ''} Q ${x0 + swagW / 2} ${top + 2 * sag} ${x1} ${top}`;
}).join(' ');

const points = Array.from({ length: swags * perSwag }, (_, i) => {
  const s = Math.floor(i / perSwag);
  const k = i % perSwag;
  const t = (k + 0.5) / perSwag;
  const x = (s * swagW + t * swagW) / W * 100;
  return {
    x: `${x.toFixed(3)}%`,
    y: `${yAt(t).toFixed(1)}px`,
    // Bulbs hang from the wire, tilted slightly with its slope.
    r: `${((t - 0.5) * -28 + (rand(i + 7) - 0.5) * 10).toFixed(1)}deg`,
    c: colors[i % colors.length],
    onDelay: `${delay + i * step}ms`,
    tw: `${(2.6 + rand(i) * 2.4).toFixed(2)}s`,
    twDelay: `${Math.round(rand(i + 31) * 1800)}ms`,
    extra: i % 2 === 1,
  };
});
---

<div
  class:list={['light-string', autoplay && 'is-on', className]}
  style={`height:${height}px`}
  data-light-string={autoplay ? undefined : ''}
  aria-hidden="true"
>
  <svg viewBox={`0 0 ${W} ${height}`} preserveAspectRatio="none" focusable="false">
    <path d={wire} fill="none" stroke="#1f4a36" stroke-width="2" vector-effect="non-scaling-stroke" stroke-linecap="round" />
    <path d={wire} fill="none" stroke="#3d6b53" stroke-width="1" vector-effect="non-scaling-stroke" stroke-dasharray="3 5" transform="translate(0 1.2)" opacity="0.6" />
  </svg>
  {
    points.map((p) => (
      <span
        class:list={['bulb', small && 'bulb-small']}
        data-extra={p.extra ? '' : undefined}
        style={`--x:${p.x};--y:${p.y};--r:${p.r};--c:${p.c};--on-delay:${p.onDelay};--tw:${p.tw};--tw-delay:${p.twDelay}`}
      >
        <span class="bulb-glow" />
        <span class="bulb-cap" />
        <span class="bulb-glass" />
        <span class="bulb-lit" />
      </span>
    ))
  }
</div>
