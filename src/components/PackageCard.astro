---
import type { Package } from '../data/packages';
import Icon from './Icon.astro';

interface Props {
  pkg: Package;
}
const { pkg } = Astro.props;
const featured = Boolean(pkg.featured);
---

<article
  class:list={[
    'card-lift relative flex flex-col justify-between rounded-xl bg-white p-6',
    featured ? 'border-2 border-brand-700 shadow-xl lg:-translate-y-2' : 'border border-slate-200 shadow-sm',
  ]}
  data-reveal
>
  {
    featured && (
      <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 rounded-full bg-brand-700 px-3.5 py-1 text-[0.625rem] font-extrabold tracking-[0.16em] whitespace-nowrap text-white uppercase shadow-md">
        {pkg.featured}
      </span>
    )
  }

  <div>
    <span
      class:list={[
        'inline-block rounded-md px-2.5 py-1 text-[0.625rem] font-extrabold tracking-wider uppercase',
        featured ? 'bg-brand-50 text-brand-700' : 'bg-slate-100 text-slate-700',
      ]}
    >
      {pkg.tier} tier
    </span>
    <h3 class="mt-3 text-2xl font-extrabold tracking-tight text-slate-900">{pkg.name}</h3>
    <p class="mt-1 text-sm leading-relaxed font-medium text-slate-600">{pkg.description}</p>

    <p class="mt-5 flex items-baseline gap-1.5 font-extrabold">
      <span class:list={['text-3xl tracking-tight', featured ? 'text-brand-700' : 'text-slate-900']}>{pkg.price.main}</span>
      {pkg.price.unit && <span class="text-xs font-bold text-slate-500">{pkg.price.unit}</span>}
    </p>

    <div class="mt-5 rounded-lg border border-slate-200 bg-slate-50 p-3">
      <span class="block text-[0.625rem] font-extrabold tracking-wider text-slate-500 uppercase">Services included</span>
      <div class="mt-2 flex flex-wrap gap-1.5">
        {
          pkg.services.map((s) => (
            <span class="inline-flex items-center gap-1 rounded-md border border-slate-200 bg-white px-2 py-1 text-[0.6875rem] font-bold text-slate-800">
              <Icon name={s.icon} class="size-3.5 text-brand-600" strokeWidth={2} />
              {s.label}
            </span>
          ))
        }
      </div>
    </div>

    <ul class="mt-5 grid gap-2.5 border-t border-slate-200 pt-5 text-sm font-medium text-slate-700">
      {
        pkg.features.map((f) => (
          <li class="flex items-start gap-2">
            <Icon name="check" class="mt-0.5 size-4 shrink-0 text-brand-600" strokeWidth={2.6} />
            {f}
          </li>
        ))
      }
    </ul>
  </div>

  <a href="#quote" class:list={['btn mt-7 w-full', featured ? 'btn-primary' : 'btn-outline']} data-package-pick={pkg.id}>
    Select {pkg.name}
  </a>
</article>
