---
import { Picture } from 'astro:assets';
import type { Package } from '../data/packages';
import Icon from './Icon.astro';

interface Props {
  pkg: Package;
}
const { pkg } = Astro.props;
const featured = Boolean(pkg.featured);
---

<article
  class:list={[
    'card-lift relative flex flex-col overflow-hidden rounded-xl bg-white',
    featured ? 'border-2 border-brand-700 shadow-xl lg:-translate-y-2' : 'border border-slate-200 shadow-sm',
  ]}
  data-reveal
>
  <div class="pkg-media">
    <Picture
      src={pkg.image}
      alt={pkg.imageAlt}
      widths={[400, 600, 800]}
      sizes="(min-width: 1024px) 22vw, (min-width: 768px) 45vw, calc(100vw - 2rem)"
      formats={['avif', 'webp']}
      loading="lazy"
      decoding="async"
    />
    <span class="absolute top-3 left-3 rounded-md bg-white/95 px-2.5 py-1 text-[0.625rem] font-extrabold tracking-wider text-slate-800 uppercase shadow-sm">
      {pkg.tier}
    </span>
    {
      featured && (
        <span class="absolute top-3 right-3 rounded-md bg-brand-700 px-2.5 py-1 text-[0.625rem] font-extrabold tracking-wider text-white uppercase shadow-sm">
          {pkg.featured}
        </span>
      )
    }
  </div>

  <div class="flex flex-1 flex-col p-5">
    <h3 class="text-xl font-extrabold tracking-tight text-slate-900">{pkg.name}</h3>
    <p class="mt-2 flex items-baseline gap-1.5 font-extrabold">
      <span class:list={['text-2xl tracking-tight', featured ? 'text-brand-700' : 'text-slate-900']}>{pkg.price.main}</span>
      {pkg.price.unit && <span class="text-xs font-bold text-slate-500">{pkg.price.unit}</span>}
    </p>
    <ul class="mt-4 grid gap-2 text-sm font-medium text-slate-700">
      {
        pkg.features.map((f) => (
          <li class="flex items-center gap-2">
            <Icon name="check" class="size-4 shrink-0 text-brand-600" strokeWidth={2.6} />
            {f}
          </li>
        ))
      }
    </ul>
    <div class="mt-auto pt-6">
      <a href="#quote" class:list={['btn w-full', featured ? 'btn-primary' : 'btn-outline']} data-package-pick={pkg.id}>
        Select
      </a>
    </div>
  </div>
</article>

<style>
  .pkg-media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-slate-200);
  }
  .pkg-media :global(picture) { display: block; height: 100%; }
  .pkg-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @media (hover: hover) {
    article:hover .pkg-media :global(img) { transform: scale(1.05); }
  }
</style>
