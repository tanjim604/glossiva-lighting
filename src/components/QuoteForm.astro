---
import { QUOTE_ENDPOINT } from 'astro:env/client';
import { packages } from '../data/packages';
import { site, telHref } from '../data/site';
import Icon from './Icon.astro';
import { withBase } from '../utils/url';

// Absolute endpoints (another host) are used as-is; site paths get the deploy base.
const endpoint = QUOTE_ENDPOINT ? (/^https?:/.test(QUOTE_ENDPOINT) ? QUOTE_ENDPOINT : withBase(QUOTE_ENDPOINT)) : '';
const notConnectedText = site.phone
  ? `Online quote requests aren’t switched on yet, so this wasn’t sent. Please call us at ${site.phone}.`
  : 'Online quote requests aren’t switched on yet on this preview, so this wasn’t sent.';
const errorFallback = site.phone
  ? `Something went wrong sending your request. Please try again, or call us at ${site.phone}.`
  : 'Something went wrong sending your request. Please try again in a moment.';
---

<section id="quote" class="border-b border-slate-200 bg-white py-16 lg:py-20">
  <div class="container-x">
    <div class="quote-layout">
      <div class="quote-intro" data-stagger="90">
        <p class="eyebrow" data-reveal>Free quote</p>
        <h2 class="section-title mt-3" data-reveal>Get your free quote</h2>
        <p class="section-lead mt-3" data-reveal>No obligation. We reply {site.responseTime}.</p>
        <div class="mt-6 flex flex-wrap gap-3" data-reveal>
          <p class="inline-flex items-baseline gap-1.5 rounded-lg border-2 border-amber-400 bg-white px-4 py-2 font-extrabold text-slate-900">
            <span class="text-2xl text-brand-700">{site.price.amount}</span>
            <span class="text-sm">{site.price.unit}</span>
          </p>
          <p class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-bold text-slate-900">
            <Icon name="shield" class="size-5 text-brand-600" strokeWidth={2} />
            {site.insurance.amount} {site.insurance.label}
          </p>
        </div>
      </div>


      <div class="form-card" data-reveal>
        <form
          class="quote-form"
          action={endpoint || undefined}
          method="post"
          novalidate
          data-quote-form
          data-endpoint={endpoint}
          data-error-text={errorFallback}
          data-not-connected-text={notConnectedText}
        >
          <div class="fields">
            <div class="field">
              <label for="q-name">Full name *</label>
              <input id="q-name" name="name" type="text" autocomplete="name" required maxlength="80" placeholder="Jane Smith" aria-describedby="q-name-err" />
              <p class="field-error" id="q-name-err" hidden></p>
            </div>
            <div class="field">
              <label for="q-phone">Phone number *</label>
              <input id="q-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required maxlength="25" placeholder="(250) 000-0000" aria-describedby="q-phone-err" />
              <p class="field-error" id="q-phone-err" hidden></p>
            </div>
            <div class="field field--full">
              <label for="q-email">Email <span class="optional">(optional)</span></label>
              <input id="q-email" name="email" type="email" inputmode="email" autocomplete="email" maxlength="120" placeholder="jane@example.com" aria-describedby="q-email-err" />
              <p class="field-error" id="q-email-err" hidden></p>
            </div>
            <div class="field field--full">
              <label for="q-address">Address or neighbourhood *</label>
              <input
                id="q-address"
                name="address"
                type="text"
                autocomplete="street-address"
                required
                maxlength="160"
                placeholder="123 Main St, or Sahali"
                aria-describedby="q-address-err"
              />
              <p class="field-error" id="q-address-err" hidden></p>
            </div>
            <div class="field field--full">
              <label for="q-package">Package</label>
              <div class="select-wrap">
                <select id="q-package" name="package" data-package-select>
                  <option value="not-sure">Not sure yet, help me choose</option>
                  {packages.map((p) => <option value={p.id}>{p.name}</option>)}
                </select>
                <Icon name="chevronDown" class="select-icon size-5" strokeWidth={2} />
              </div>
            </div>
            <div class="field field--full">
              <label for="q-notes">Anything we should know? <span class="optional">(optional)</span></label>
              <textarea
                id="q-notes"
                name="notes"
                rows="3"
                maxlength="1000"
                placeholder="e.g. two-storey home, warm white lights"></textarea>
            </div>
          </div>

          {/* Spam trap: hidden from people, irresistible to bots. */}
          <div class="hp" aria-hidden="true">
            <label>Company <input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
          </div>
          {['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'fbclid', 'elapsed', 'page'].map((n) => <input type="hidden" name={n} />)}

          <button type="submit" class="btn btn-primary btn-lg submit-btn w-full" data-submit>
            <span class="submit-label">Send my free quote request</span>
            <span class="spinner" aria-hidden="true"></span>
          </button>
          <p class="mt-3 text-center text-xs font-medium text-slate-500">No obligation, no spam. Just your quote.</p>
          <p class="form-error" role="alert" data-form-error hidden></p>
        </form>

        <div class="form-success" data-form-success hidden tabindex="-1">
          <span class="grid size-16 place-items-center rounded-full bg-brand-700 text-white shadow-lg">
            <Icon name="check" class="size-8" strokeWidth={2.6} />
          </span>
          <h3 class="mt-5 text-2xl font-extrabold text-slate-900">Thank you<span data-success-name></span>!</h3>
          <p class="mt-3 max-w-sm text-sm leading-relaxed font-medium text-slate-600">
            Your request is on its way. We’ll be in touch {site.responseTime} with your free quote.
          </p>
          {
            site.phone && (
              <a href={telHref(site.phone)} class="btn btn-outline btn-sm mt-6">
                <Icon name="phone" class="size-4" /> Prefer to talk? {site.phone}
              </a>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Phones: heading → form → next steps, so the first field is close to where "Get my free quote" lands. */
  .quote-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'intro' 'form';
    gap: 2rem;
  }
  .quote-intro { grid-area: intro; }
  .form-card { grid-area: form; }

  .form-card {
    border-radius: 1rem;
    border: 1px solid var(--color-slate-200);
    background: #fff;
    padding: 1.5rem 1.25rem;
    box-shadow: 0 20px 45px -24px rgb(15 23 42 / 0.3);
  }
  .fields {
    display: grid;
    gap: 1.125rem;
  }
  .field { display: grid; gap: 0.375rem; }
  .field label {
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-slate-700);
  }
  .optional { font-weight: 600; letter-spacing: 0; text-transform: none; color: var(--color-slate-500); }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 3.125rem;
    padding: 0.75rem 1rem;
    border-radius: 0.625rem;
    border: 1px solid var(--color-slate-300);
    background: #fff;
    color: var(--color-slate-900);
    font-size: 1rem; /* 16px: stops iOS from zooming in on focus */
    font-weight: 500;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .field textarea { resize: vertical; min-height: 6rem; line-height: 1.5; }
  .field ::placeholder { color: var(--color-slate-400); }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--color-brand-600);
    box-shadow: 0 0 0 3px rgb(31 138 63 / 0.18);
  }
  .field [aria-invalid='true'] {
    border-color: var(--color-red-600);
    box-shadow: 0 0 0 3px rgb(220 38 38 / 0.12);
  }
  .field-error {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-red-700);
  }
  .select-wrap { position: relative; }
  .select-wrap select {
    appearance: none;
    padding-right: 2.75rem;
    cursor: pointer;
    font-weight: 600;
  }
  .select-wrap :global(.select-icon) {
    position: absolute;
    right: 1rem;
    top: 50%;
    translate: 0 -50%;
    color: var(--color-slate-500);
    pointer-events: none;
  }
  .select-wrap select.is-picked {
    animation: picked 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes picked {
    0% { box-shadow: 0 0 0 0 rgb(31 138 63 / 0.45); border-color: var(--color-brand-600); }
    100% { box-shadow: 0 0 0 10px rgb(31 138 63 / 0); }
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .submit-btn { margin-top: 1.5rem; }
  .spinner {
    display: none;
    width: 1.125rem;
    height: 1.125rem;
    border-radius: 999px;
    border: 2.5px solid rgb(255 255 255 / 0.4);
    border-top-color: #fff;
    animation: spin 0.8s linear infinite;
  }
  .submit-btn[aria-busy='true'] { pointer-events: none; opacity: 0.9; }
  .submit-btn[aria-busy='true'] .spinner { display: inline-block; }
  .form-error {
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    border-radius: 0.625rem;
    border: 1px solid var(--color-red-200);
    background: var(--color-red-50);
    color: var(--color-red-800);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .form-success {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 2rem 0.5rem;
    outline: none;
  }
  .form-success[hidden] { display: none; }

  @media (width >= 40rem) {
    .fields { grid-template-columns: 1fr 1fr; }
    .field--full { grid-column: 1 / -1; }
    .form-card { padding: 2rem; }
  }
  @media (width >= 64rem) {
    .quote-layout {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-areas: 'intro form';
      align-items: center;
      column-gap: 4rem;
      row-gap: 2.5rem;
      align-items: start;
    }
    .form-card { padding: 2.5rem; }
  }
</style>
