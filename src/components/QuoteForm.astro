---
import { QUOTE_ENDPOINT } from 'astro:env/client';
import { packages } from '../data/packages';
import { site, telHref } from '../data/site';
import Icon from './Icon.astro';
import InsuranceBadge from './InsuranceBadge.astro';
import LightString from './LightString.astro';
import { withBase } from '../utils/url';

const nextSteps = [
  'We review your home and lighting wishes.',
  `We send your free quote ${site.responseTime}.`,
  'You pick your install date. That’s it.',
];
// Absolute endpoints (another host) are used as-is; site paths get the deploy base.
const endpoint = QUOTE_ENDPOINT ? (/^https?:/.test(QUOTE_ENDPOINT) ? QUOTE_ENDPOINT : withBase(QUOTE_ENDPOINT)) : '';
const notConnectedText = site.phone
  ? `Online quote requests aren’t switched on yet, so this wasn’t sent. Please call us at ${site.phone}.`
  : 'Online quote requests aren’t switched on yet on this preview, so this wasn’t sent.';
const errorFallback = site.phone
  ? `Something went wrong sending your request. Please try again, or call us at ${site.phone}.`
  : 'Something went wrong sending your request. Please try again in a moment.';
---

<section id="quote" class="sheet bg-cream pt-16 pb-24 lg:pt-24 lg:pb-32">
  <div class="container-x">
    <div class="quote-layout">
      <div class="quote-intro" data-stagger="90">
        <p class="eyebrow" data-reveal><span class="eyebrow-dot"></span>Free quote</p>
        <h2 class="section-title mt-4" data-reveal>Let’s light up your home</h2>
        <p class="section-lead mt-4" data-reveal>
          Tell us a little about your place and we’ll put together your free, no-obligation quote.
        </p>

        <div class="quote-highlights" data-reveal>
          <p class="mini-tag">
            <span class="font-display mini-tag-amount">{site.price.amount}</span>
            <span class="mini-tag-unit">{site.price.unit}</span>
          </p>
          <InsuranceBadge variant="chip" />
        </div>
      </div>

      <ol class="next-steps" data-reveal aria-label="What happens next">
        {
          nextSteps.map((step, i) => (
            <li>
              <span class="next-num font-display">{i + 1}</span>
              {step}
            </li>
          ))
        }
      </ol>

      <div class="form-card card" data-reveal>
        <form
          class="quote-form"
          action={endpoint || undefined}
          method="post"
          novalidate
          data-quote-form
          data-endpoint={endpoint}
          data-error-text={errorFallback}
          data-not-connected-text={notConnectedText}
        >
          <div class="fields">
            <div class="field">
              <label for="q-name">Your name</label>
              <input id="q-name" name="name" type="text" autocomplete="name" required maxlength="80" aria-describedby="q-name-err" />
              <p class="field-error" id="q-name-err" hidden></p>
            </div>
            <div class="field">
              <label for="q-phone">Phone</label>
              <input id="q-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required maxlength="25" aria-describedby="q-phone-err" />
              <p class="field-error" id="q-phone-err" hidden></p>
            </div>
            <div class="field field--full">
              <label for="q-email">Email <span class="optional">(optional)</span></label>
              <input id="q-email" name="email" type="email" inputmode="email" autocomplete="email" maxlength="120" aria-describedby="q-email-err" />
              <p class="field-error" id="q-email-err" hidden></p>
            </div>
            <div class="field field--full">
              <label for="q-address">Address or neighbourhood</label>
              <input
                id="q-address"
                name="address"
                type="text"
                autocomplete="street-address"
                required
                maxlength="160"
                placeholder="e.g. 123 Main St, or Sahali"
                aria-describedby="q-address-err"
              />
              <p class="field-error" id="q-address-err" hidden></p>
            </div>
            <div class="field field--full">
              <label for="q-package">Package</label>
              <div class="select-wrap">
                <select id="q-package" name="package" data-package-select>
                  <option value="not-sure">Not sure yet, help me choose</option>
                  {packages.map((p) => <option value={p.id}>{p.name}</option>)}
                </select>
                <Icon name="chevronDown" class="select-icon size-5" strokeWidth={2} />
              </div>
            </div>
            <div class="field field--full">
              <label for="q-notes">Anything we should know? <span class="optional">(optional)</span></label>
              <textarea
                id="q-notes"
                name="notes"
                rows="3"
                maxlength="1000"
                placeholder="e.g. two-storey home, a big spruce out front"></textarea>
            </div>
          </div>

          {/* Spam trap: hidden from people, irresistible to bots. */}
          <div class="hp" aria-hidden="true">
            <label>Company <input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
          </div>
          {['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'fbclid', 'elapsed', 'page'].map((n) => <input type="hidden" name={n} />)}

          <button type="submit" class="btn btn-primary submit-btn w-full" data-submit>
            <span class="submit-label">Send my free quote request</span>
            <span class="spinner" aria-hidden="true"></span>
          </button>
          <p class="form-note">No obligation, no spam. Just your quote.</p>
          <p class="form-error" role="alert" data-form-error hidden></p>
        </form>

        <div class="form-success" data-form-success hidden tabindex="-1">
          <LightString swags={2} bulbs={10} height={52} sag={18} top={6} delay={150} step={90} small />
          <span class="success-icon"><Icon name="check" class="size-7" strokeWidth={2.4} /></span>
          <h3 class="success-title font-display">Thank you<span data-success-name></span>!</h3>
          <p class="success-text">
            Your request is on its way. We’ll be in touch {site.responseTime} with your free quote.
          </p>
          {
            site.phone && (
              <a href={telHref(site.phone)} class="btn btn-secondary btn-sm mt-6">
                <Icon name="phone" class="size-4" /> Prefer to talk? {site.phone}
              </a>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Phones: heading → form → next steps, so the first field is close to where "Get my free quote" lands. */
  .quote-layout {
    display: grid;
    grid-template-areas: 'intro' 'form' 'steps';
    gap: 1.75rem;
  }
  .quote-intro { grid-area: intro; }
  .form-card { grid-area: form; }
  .next-steps { grid-area: steps; }
  .quote-highlights {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .mini-tag {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.4rem 1.1rem;
    border-radius: 999px;
    background: linear-gradient(165deg, #fbe3a2, #f1c869 60%, #e7b552);
    color: var(--color-pine-700);
    box-shadow: 0 10px 24px -12px rgb(154 107 23 / 0.6), 0 0 30px rgb(255 217 138 / 0.45), inset 0 1px 0 rgb(255 255 255 / 0.6);
  }
  .mini-tag-amount {
    font-size: 1.625rem;
    font-weight: 750;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .mini-tag-unit { font-size: 0.875rem; font-weight: 700; }
  .next-steps {
    display: grid;
    gap: 0.75rem;
    padding-inline: 0.25rem;
  }
  .next-steps li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .next-num {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--color-line);
    color: var(--color-pine);
    font-weight: 700;
  }

  .form-card {
    position: relative;
    padding: 1.5rem 1.125rem 1.25rem;
    border-radius: 2rem;
    box-shadow: var(--shadow-lift);
  }
  .fields {
    display: grid;
    gap: 1rem;
  }
  .field { display: grid; gap: 0.375rem; }
  .field label {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-pine);
  }
  .optional { font-weight: 500; color: var(--color-muted); }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 3.25rem;
    padding: 0.75rem 1rem;
    border-radius: 1rem;
    border: 1.5px solid var(--color-line);
    background: var(--color-snow);
    color: var(--color-ink);
    font-size: 1rem; /* 16px: stops iOS from zooming in on focus */
    transition: border-color 0.25s, box-shadow 0.25s, background-color 0.25s;
  }
  .field textarea { resize: vertical; min-height: 6rem; line-height: 1.5; }
  .field ::placeholder { color: #9aa49e; }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    background: #fff;
    border-color: var(--color-gold);
    box-shadow: 0 0 0 4px rgb(244 182 63 / 0.25);
  }
  .field [aria-invalid='true'] {
    border-color: var(--color-cranberry);
    box-shadow: 0 0 0 4px rgb(181 54 75 / 0.12);
  }
  .field-error {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-cranberry-700);
  }
  .select-wrap { position: relative; }
  .select-wrap select {
    appearance: none;
    padding-right: 2.75rem;
    cursor: pointer;
  }
  .select-wrap :global(.select-icon) {
    position: absolute;
    right: 1rem;
    top: 50%;
    translate: 0 -50%;
    color: var(--color-pine);
    pointer-events: none;
  }
  .select-wrap select.is-picked {
    animation: picked 1.2s var(--ease-soft);
  }
  @keyframes picked {
    0% { box-shadow: 0 0 0 0 rgb(244 182 63 / 0.6); border-color: var(--color-gold); }
    100% { box-shadow: 0 0 0 10px rgb(244 182 63 / 0); }
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .submit-btn {
    margin-top: 1.5rem;
    min-height: 3.5rem;
    font-size: 1.0625rem;
  }
  .spinner {
    display: none;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 999px;
    border: 2.5px solid rgb(255 255 255 / 0.4);
    border-top-color: #fff;
    animation: spin 0.8s linear infinite;
  }
  .submit-btn[aria-busy='true'] { pointer-events: none; opacity: 0.9; }
  .submit-btn[aria-busy='true'] .spinner { display: inline-block; }
  .form-note {
    margin-top: 0.75rem;
    text-align: center;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  .form-error {
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    border-radius: 1rem;
    background: rgb(181 54 75 / 0.08);
    color: var(--color-cranberry-700);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .form-success {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0.5rem 0.5rem 1.5rem;
    outline: none;
  }
  .form-success[hidden] { display: none; }
  .form-success :global(.light-string) { margin-bottom: 1.5rem; }
  .success-icon {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: 999px;
    background: linear-gradient(160deg, #2b6047, #1f4a36);
    color: #fff;
    box-shadow: 0 14px 30px -12px rgb(31 74 54 / 0.7);
    animation: rise 0.8s var(--ease-bounce) 0.3s both;
  }
  .success-title {
    margin-top: 1.25rem;
    font-size: 2rem;
    font-weight: 650;
    color: var(--color-pine);
  }
  .success-text {
    margin-top: 0.75rem;
    max-width: 24rem;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--color-muted);
  }

  @media (width >= 40rem) {
    .fields { grid-template-columns: 1fr 1fr; }
    .field--full { grid-column: 1 / -1; }
    .form-card { padding: 2rem; }
  }
  @media (width >= 64rem) {
    .quote-layout {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      grid-template-areas: 'intro form' 'steps form';
      grid-template-rows: auto 1fr;
      column-gap: 4rem;
      row-gap: 2rem;
      align-items: start;
    }
    .form-card { padding: 2.5rem; border-radius: 2.5rem; }
  }
</style>
