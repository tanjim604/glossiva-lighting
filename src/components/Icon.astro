  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  bulb: '<path d="M9.5 3.5h5v3h-5z"/><path d="M12 6.5c3.6 0 5 4.3 3.2 8-1 2-2.1 3.7-3.2 5.2-1.1-1.5-2.2-3.2-3.2-5.2-1.8-3.7-.4-8 3.2-8Z"/>',
} as const;

export type IconName = keyof typeof paths;

interface Props {
  name: IconName;
  class?: string;
  strokeWidth?: number;
}
const { name, class: className = 'size-5', strokeWidth = 1.8 } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
