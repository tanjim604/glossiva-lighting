---
import { site } from '../data/site';
import Icon from './Icon.astro';
---

<div class="sticky-cta lg:hidden" data-sticky-cta>
  <a href="#quote" class="btn btn-primary w-full text-[1.0625rem]" tabindex="-1">
    Get my free quote
    <span class="opacity-80">· {site.price.short}</span>
    <Icon name="arrowRight" class="size-5" strokeWidth={2.2} />
  </a>
</div>

<style>
  .sticky-cta {
    position: fixed;
    z-index: 40;
    left: 1rem;
    right: 1rem;
    bottom: calc(0.75rem + env(safe-area-inset-bottom));
    transform: translateY(calc(100% + 1.5rem));
    visibility: hidden;
    transition:
      transform 0.7s var(--ease-bounce),
      visibility 0s linear 0.7s;
  }
  .sticky-cta :global(.btn) {
    min-height: 3.5rem;
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.25) inset,
      0 18px 40px -12px rgb(181 54 75 / 0.7),
      0 4px 12px -4px rgb(0 0 0 / 0.15);
  }
  .sticky-cta.is-visible {
    transform: none;
    visibility: visible;
    transition:
      transform 0.7s var(--ease-bounce),
      visibility 0s;
  }
</style>
