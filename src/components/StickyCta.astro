---
import { site } from '../data/site';
import Icon from './Icon.astro';
---

<div class="sticky-cta lg:hidden" data-sticky-cta>
  <a href="#quote" class="btn btn-primary btn-lg w-full" tabindex="-1">
    Get my free quote <span class="font-bold opacity-80">· {site.price.short}</span>
    <Icon name="arrowRight" class="size-4" strokeWidth={2.4} />
  </a>
</div>

<style>
  .sticky-cta {
    position: fixed;
    z-index: 40;
    left: 1rem;
    right: 1rem;
    bottom: calc(0.75rem + env(safe-area-inset-bottom));
    transform: translateY(calc(100% + 1.5rem));
    visibility: hidden;
    transition:
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s linear 0.5s;
  }
  .sticky-cta :global(.btn) {
    box-shadow: 0 16px 36px -12px rgb(15 23 42 / 0.45);
  }
  .sticky-cta.is-visible {
    transform: none;
    visibility: visible;
    transition:
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s;
  }
</style>
