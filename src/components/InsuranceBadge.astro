---
import { site } from '../data/site';
import Icon from './Icon.astro';

interface Props {
  /** `chip` = inline pill, `card` = stacked block, `hero` = card on mobile, chip on desktop. */
  variant?: 'chip' | 'card' | 'hero';
  class?: string;
}
const { variant = 'chip', class: className = '' } = Astro.props;
---

<div class:list={['ins', `ins--${variant}`, className]}>
  <span class="ins-icon"><Icon name="shield" class="size-5" strokeWidth={2} /></span>
  <span class="ins-text">
    <strong class="ins-amount font-display">{site.insurance.amount}</strong>
    <span class="ins-label">{site.insurance.label}</span>
  </span>
</div>

<style>
  .ins {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--color-pine);
  }
  .ins-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    background: linear-gradient(160deg, #2b6047, #1f4a36);
    color: #fff;
    box-shadow: 0 6px 16px -6px rgb(31 74 54 / 0.6), inset 0 1px 0 rgb(255 255 255 / 0.2);
  }
  .ins-text {
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
    line-height: 1.2;
  }
  .ins-amount {
    font-size: 1.125rem;
    font-weight: 700;
  }
  .ins-label {
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .ins--chip {
    padding: 0.375rem 1rem 0.375rem 0.375rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.85);
    border: 1px solid var(--color-line);
    box-shadow: var(--shadow-soft);
  }

  .ins--card,
  .ins--hero {
    flex-direction: column;
    justify-content: center;
    gap: 0.5rem;
    padding: 1.1rem 0.75rem;
    border-radius: 1.75rem;
    background: rgb(255 255 255 / 0.9);
    border: 1px solid var(--color-line);
    box-shadow: var(--shadow-soft);
    text-align: center;
  }
  .ins--card .ins-icon,
  .ins--hero .ins-icon {
    width: 3rem;
    height: 3rem;
  }
  .ins--card .ins-text,
  .ins--hero .ins-text {
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
  }
  .ins--card .ins-amount,
  .ins--hero .ins-amount {
    font-size: 2.25rem;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .ins--card .ins-label,
  .ins--hero .ins-label {
    font-size: 0.8125rem;
    max-width: 8rem;
  }

  @media (width >= 64rem) {
    .ins--hero {
      flex-direction: row;
      gap: 0.625rem;
      padding: 0.375rem 1.125rem 0.375rem 0.375rem;
      border-radius: 999px;
      text-align: left;
    }
    .ins--hero .ins-icon { width: 2.25rem; height: 2.25rem; }
    .ins--hero .ins-text { flex-direction: row; align-items: baseline; gap: 0.375rem; }
    .ins--hero .ins-amount { font-size: 1.125rem; }
    .ins--hero .ins-label { font-size: 0.9375rem; max-width: none; }
  }
</style>
