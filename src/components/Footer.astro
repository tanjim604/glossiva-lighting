---
import { nav, site, telHref } from '../data/site';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer data-hide-sticky>
  <div class="bg-brand-700 text-white">
    <div class="container-x flex flex-col items-start gap-6 py-12 lg:flex-row lg:items-center lg:justify-between" data-reveal>
      <div>
        <h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">Ready to glow this December?</h2>
        <p class="mt-2 text-sm font-medium text-brand-100">{site.price.compact} · {site.insurance.amount} insured</p>
      </div>
      <a href="#quote" class="btn btn-lg w-full bg-white text-brand-800 shadow-lg hover:bg-brand-50 sm:w-auto">
        Get my free quote <Icon name="arrowRight" class="size-4" strokeWidth={2.4} />
      </a>
    </div>
  </div>

  <div class="border-t border-slate-200 bg-slate-50">
    <div class="container-x grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <Logo variant="stacked" class="w-40" />
        <p class="mt-5 max-w-sm text-sm font-medium text-slate-600">Christmas lights, installed and taken down. {site.city}, {site.region}.</p>
      </div>

      <nav aria-label="Footer" class="lg:col-span-2">
        <p class="text-xs font-extrabold tracking-wider text-slate-900 uppercase">Explore</p>
        <ul class="mt-4 grid gap-2.5 text-sm font-medium text-slate-600">
          {nav.map((item) => <li><a href={item.href} class="hover:text-brand-700">{item.label}</a></li>)}
          <li><a href="#quote" class="hover:text-brand-700">Free quote</a></li>
        </ul>
      </nav>

      <div class="lg:col-span-2">
        <p class="text-xs font-extrabold tracking-wider text-slate-900 uppercase">Service area</p>
        <ul class="mt-4 grid gap-2.5 text-sm font-medium text-slate-600">
          <li>{site.serviceArea}</li>
        </ul>
      </div>

      <div class="lg:col-span-3">
        <p class="text-xs font-extrabold tracking-wider text-slate-900 uppercase">Contact &amp; pricing</p>
        <ul class="mt-4 grid gap-2.5 text-sm font-medium text-slate-600">
          <li class="flex items-center gap-2 font-bold text-brand-700">
            <Icon name="tag" class="size-4" strokeWidth={2.2} /> Roofline {site.price.compact}
          </li>
          <li class="flex items-center gap-2">
            <Icon name="shield" class="size-4 text-brand-600" strokeWidth={2} /> {site.insurance.amount} {site.insurance.label}
          </li>
          {
            site.phone && (
              <li>
                <a href={telHref(site.phone)} class="flex items-center gap-2 hover:text-brand-700">
                  <Icon name="phone" class="size-4 text-brand-600" /> {site.phone}
                </a>
              </li>
            )
          }
          {
            site.email && (
              <li>
                <a href={`mailto:${site.email}`} class="flex items-center gap-2 hover:text-brand-700">
                  <Icon name="mail" class="size-4 text-brand-600" /> {site.email}
                </a>
              </li>
            )
          }
        </ul>
        {
          (site.social.instagram || site.social.facebook) && (
            <div class="mt-5 flex gap-2">
              {site.social.facebook && (
                <a href={site.social.facebook} class="social" aria-label="Facebook" target="_blank" rel="noopener">
                  <Icon name="facebook" class="size-5" />
                </a>
              )}
              {site.social.instagram && (
                <a href={site.social.instagram} class="social" aria-label="Instagram" target="_blank" rel="noopener">
                  <Icon name="instagram" class="size-5" />
                </a>
              )}
            </div>
          )
        }
      </div>
    </div>

    <div class="border-t border-slate-200">
      <div class="container-x flex flex-col gap-3 py-6 text-xs font-medium text-slate-500 sm:flex-row sm:items-start sm:justify-between">
        <p>© {year} {site.name}. All rights reserved.</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .social {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.5rem;
    border: 1px solid var(--color-slate-200);
    background: #fff;
    color: var(--color-slate-700);
    transition: color 0.2s, border-color 0.2s;
  }
  .social:hover { color: var(--color-brand-700); border-color: var(--color-brand-200); }
</style>
